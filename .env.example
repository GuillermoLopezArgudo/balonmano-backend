# Local
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/balonmano

# Neon (Render env): pega la connection string de Neon (postgres:// o postgresql://).
# La app la normaliza a postgresql+psycopg:// y añade sslmode=require si falta.
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Producción (Vercel front):
# CORS_ORIGINS=https://tu-app.vercel.app

AUTH_SECRET=cambia-este-secreto-largo-y-aleatorio-min-32-chars
AUTH_TOKEN_HOURS=72
UPLOADS_DIR=uploads
APP_ENV=development
# Solo local si aún usas el secreto por defecto del código (nunca en prod):
# ALLOW_INSECURE_AUTH=true
# En production, STRICT_SCHEMA es true por defecto (ALTER fallido = no arranca):
# STRICT_SCHEMA=true
