DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/balonmano
# En Render: pega la Internal/External Database URL; la app la normaliza a +psycopg2.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET=cambia-este-secreto-largo-y-aleatorio-min-32-chars
AUTH_TOKEN_HOURS=72
UPLOADS_DIR=uploads
APP_ENV=development
# Solo local si aún usas el secreto por defecto del código (nunca en prod):
# ALLOW_INSECURE_AUTH=true
# En production, STRICT_SCHEMA es true por defecto (ALTER fallido = no arranca):
# STRICT_SCHEMA=true
